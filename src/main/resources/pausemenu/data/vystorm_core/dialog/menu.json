     "action": {"type": "minecraft:dynamic/custom", "id": "vystorm_core:pause/settings"}},
    {"label": {"text": "{{pause.tutorials}}"}, "tooltip": {"text": "{{pause.tutorials-tooltip}}"}, "width": 200,
     "action": {"type": "minecraft:dynamic/custom", "id": "vystorm_core:pause/tutorials"}}
